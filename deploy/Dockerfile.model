# AyurParam model server (NVIDIA GPU). Weights are mounted at /models/AyurParam (not baked in).
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONUTF8=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv
ENV PATH=/venv/bin:$PATH
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cu128 && \
    pip install --no-cache-dir transformers==4.53.1 tokenizers==0.21.2 safetensors==0.5.3 accelerate==1.8.1 fastapi==0.115.12 uvicorn==0.34.3 pydantic==2.11.5
WORKDIR /app
COPY model_server/ model_server/
ENV AYURPARAM_LOCAL_DIR=/models/AyurParam AYURPARAM_HOST=0.0.0.0 AYURPARAM_PORT=8601
EXPOSE 8601
CMD ["python", "model_server/server.py"]
