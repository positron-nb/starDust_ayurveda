# --- API (backend) ---
# http = call the separate AyurParam model server; fixture = replay recorded live outputs
# (clearly labelled, never reported as live); off = retrieval-only mode.
PRAMAAN_LLM_MODE=http
AYURPARAM_SERVER_URL=http://127.0.0.1:8601
AYURPARAM_TIMEOUT_S=180
# local (all features) | public_demo (read-only: review/admin routes disabled, runs listed per session only)
PRAMAAN_DEPLOY_MODE=local
PRAMAAN_RATE_LIMIT=30
PRAMAAN_ENABLE_DENSE=1
# empty = embedded Qdrant (data/build/qdrant); set to http://qdrant:6333 in Docker Compose
QDRANT_URL=
# 1 = append live AyurParam outputs to eval/fixtures/ayurparam_replay.jsonl (for offline demo replay)
PRAMAAN_RECORD_FIXTURES=0

# --- model server ---
AYURPARAM_LOCAL_DIR=./models/AyurParam
AYURPARAM_HOST=127.0.0.1
AYURPARAM_PORT=8601
# cpu to force CPU (FP32 needs ~12 GB RAM for weights alone); AYURPARAM_CPU_BF16=1 halves that, slower
AYURPARAM_DEVICE=
AYURPARAM_USE_CACHE=1
