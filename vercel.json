{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/pramaan/**,data/curated/**,data/rules/**,data/terminology/**,data/sources/manifest.json,data/sources/external/**,deploy/vercel/corpus.sqlite,eval/results/*.json,eval/cases.jsonl,eval/indic_cases.jsonl}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
